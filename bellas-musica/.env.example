# Copy to .env (or set these in your host's dashboard). Never commit real values.
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example        # must be your public https address (cookies and Stripe redirects use it)
SESSION_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32
DATA_DIR=/data                               # SQLite database and photo uploads live here; back it up
TRUST_PROXY=1                                # 1 when running behind a proxy/load balancer (Render, Fly, Railway...)
ADMIN_EMAILS=you@example.com                # who can open the owner page (comma-separated)
BUSINESS_TZ=America/Chicago                  # the time zone whose calendar day counts as "today" (refund windows, holds)
DEMO_SEED=1                                  # 0 removes the fictional sample groups once you have real ones

# Money
PLATFORM_FEE_PCT=10                          # your fee: % of the booking total, taken from the deposit
FEATURE_PRICE_CENTS=4900                     # price of 30 days of featured placement

# Stripe: leave STRIPE_SECRET_KEY empty to run in test mode with simulated payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend, resend.com): leave empty to only log emails
RESEND_API_KEY=
EMAIL_FROM=Bella's Música <hello@your-domain.example>
EMAIL_REPLY_TO=
BUSINESS_NAME=Bella's Música
BUSINESS_ADDRESS=                            # postal address shown in email footers (required for commercial email in the US)
SUPPORT_EMAIL=

# Operations
SENTRY_DSN=                                  # optional, free plan at sentry.io: crash reports with stack traces (also receives browser crashes)
ALERT_WEBHOOK_URL=                           # Slack/Discord/any JSON webhook: told when something breaks
BACKUP_DIR=/data/backups                     # daily database copies (keeps BACKUP_KEEP days); also back up DATA_DIR/uploads
BACKUP_KEEP=14

# Twilio texts: leave empty to only log messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Sitemap (seconds it is cached; it is rebuilt from every group, so keep this above 0 in production)
SITEMAP_CACHE=600
# Weather for party pages (National Weather Service, free, no key). WEATHER=0 turns it off.
# WEATHER=0
